# .env.fuji — Avalanche Fuji C-Chain (43113). Copy thành backend/.env.fuji và điền giá trị thật.
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=fuji
VOICE_CAMPAIGNS=0x...         # địa chỉ trên Fuji (in ra từ Deploy.s.sol; cũng có trong contracts/deployments/43113.json)
TOKEN_ADDRESS=0x...           # MockUSDC trên Fuji
DEPLOY_BLOCK=0                # block deploy (giúp indexer khỏi quét từ đầu)
RELAYER_PRIVATE_KEY=0x...     # ví relayer thật của đội (đã nạp AVAX test từ Core faucet)
USDC_VND_RATE=26000
JWT_SECRET=change-me-to-a-long-random-string-32+
TOKEN_SECRET=change-me-to-another-long-random-string
ADMIN_API_KEY=change-me
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
DEV_AUTH_ENABLED=false
API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=https://your-frontend.vercel.app
LOG_CHUNK_BLOCKS=2000

# .env.fuji — Avalanche Fuji C-Chain (43113). Copy thành backend/.env.fuji và điền giá trị thật.
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=fuji
VOICE_CAMPAIGNS=0x...         # địa chỉ trên Fuji (in ra từ Deploy.s.sol; cũng có trong contracts/deployments/43113.json)
TOKEN_ADDRESS=0x...           # MockUSDC trên Fuji
DEPLOY_BLOCK=0                # block deploy (giúp indexer khỏi quét từ đầu)
RELAYER_PRIVATE_KEY=0x...     # ví relayer thật của đội (đã nạp AVAX test từ Core faucet)
USDC_VND_RATE=26000
# Phí xử lý (đã gồm phí mạng nền tảng trả hộ), đơn vị USDC: tạo chiến dịch, mua, rút doanh thu/quỹ mồi
RELAY_FEE_CREATE_USDC=0.5
RELAY_FEE_BUY_USDC=0.5
RELAY_FEE_WITHDRAW_USDC=0.1
JWT_SECRET=change-me-to-a-long-random-string-32+
TOKEN_SECRET=change-me-to-another-long-random-string
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
DEV_AUTH_ENABLED=false
API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=https://your-frontend.vercel.app
LOG_CHUNK_BLOCKS=2000
# Database (khuyến nghị Neon, nhánh production). KHÔNG reset khi contract Fuji còn đang dùng.
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
# DATABASE_SCHEMA=fuji_v1     # đổi schema khi deploy contract mới
REVIEW_AUTO_APPROVE_HOURS=72  # chủ chiến dịch chưa duyệt vùng xám sau 72 giờ => tự duyệt (0 = chờ mãi)
# Kho audio Backblaze B2 (khuyến nghị cho server công khai). Bucket RIÊNG TƯ; key chỉ cấp cho bucket này.
# B2_KEY_ID=...
# B2_APPLICATION_KEY=...      # BÍ MẬT, KHÔNG commit
# B2_BUCKET=...

# .env.mainnet — Avalanche C-Chain (43114). USDC THẬT, không faucet, không SeedDemo, không dev login.
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=mainnet
VOICE_CAMPAIGNS=0x...         # bắt buộc (không đọc file deployments ở mainnet)
TOKEN_ADDRESS=0x...           # USDC thật (tra tài liệu chính thức của Circle)
DEPLOY_BLOCK=0
RELAYER_PRIVATE_KEY=0x...
FX_URL=https://...            # bắt buộc: nguồn tỷ giá USDC/VND (JSON), cache 5 phút
FX_JSON_KEY=rate
# Phí xử lý (đã gồm phí mạng nền tảng trả hộ), đơn vị USDC: tạo chiến dịch, mua, rút doanh thu/quỹ mồi
RELAY_FEE_CREATE_USDC=0.5
RELAY_FEE_BUY_USDC=0.5
RELAY_FEE_WITHDRAW_USDC=0.1
JWT_SECRET=...
TOKEN_SECRET=...
GOOGLE_CLIENT_ID=...
DEV_AUTH_ENABLED=false
API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=https://your-frontend.example.com
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require   # PostgreSQL bắt buộc nên dùng cho production
REVIEW_AUTO_APPROVE_HOURS=72
# B2_KEY_ID=...               # Backblaze B2: bucket riêng tư cho audio (bỏ trống B2_BUCKET = lưu trên đĩa)
# B2_APPLICATION_KEY=...      # BÍ MẬT, KHÔNG commit
# B2_BUCKET=...

# .env.mainnet — Avalanche C-Chain (43114). USDC THẬT, không faucet, không SeedDemo, không dev login.
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=mainnet
VOICE_CAMPAIGNS=0x...         # bắt buộc (không đọc file deployments ở mainnet)
TOKEN_ADDRESS=0x...           # USDC thật (tra tài liệu chính thức của Circle)
DEPLOY_BLOCK=0
RELAYER_PRIVATE_KEY=0x...
FX_URL=https://...            # bắt buộc: nguồn tỷ giá USDC/VND (JSON), cache 5 phút
FX_JSON_KEY=rate
JWT_SECRET=...
TOKEN_SECRET=...
ADMIN_API_KEY=...
GOOGLE_CLIENT_ID=...
DEV_AUTH_ENABLED=false
API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=https://your-frontend.example.com

# ==== Dataset Marketplace backend — mẫu cấu hình chung (xem thêm .env.local.example / .env.fuji.example / .env.mainnet.example)
# Cách lấy từng giá trị: docs/environment-variables.md
# Backend tự nạp file backend/.env.<NETWORK>. KHÔNG commit file .env thật.
NETWORK=local                 # local | fuji | mainnet
# RPC_URL=                    # bỏ trống = RPC mặc định của mạng
# VOICE_CAMPAIGNS=0x...       # bỏ trống ở local/fuji = đọc contracts/deployments/<chainId>.json
# TOKEN_ADDRESS=0x...
# DEPLOY_BLOCK=0
RELAYER_PRIVATE_KEY=0x...     # ví nóng trả gas (relayer); cũng là QC oracle nếu không đặt QC_ORACLE_PRIVATE_KEY
# QC_ORACLE_PRIVATE_KEY=0x...
USDC_VND_RATE=26000           # tỷ giá cố định (local/fuji)
# FX_URL=https://...          # bắt buộc ở mainnet: JSON {"rate": <VND cho 1 USDC>}
# FX_JSON_KEY=rate
JWT_SECRET=                   # bắt buộc ngoài local (>= 32 ký tự)
TOKEN_SECRET=                 # HMAC prompt token / link tải, bắt buộc ngoài local (>= 32 ký tự)
ADMIN_API_KEY=                # header X-Admin-Key cho /admin/*, bắt buộc ngoài local
GOOGLE_CLIENT_ID=             # OAuth client id cho POST /auth/google
DEV_AUTH_ENABLED=false        # CHỈ local; bật ở mạng khác => backend từ chối khởi động
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:8000
# PROMPT_TOKEN_TTL_SEC=60  DOWNLOAD_TOKEN_TTL_SEC=600  AUTO_SNAPSHOT_ON_REVOKE=true
# QC_MODEL_ID=nguyenvulebinh/wav2vec2-base-vietnamese-250h  QC_NUM_THREADS=2  QC_PRELOAD=false  QC_WEIGHT_SOURCE=speech
# STORAGE_DIR=../storage   RATE_LIMIT_ENABLED=true   INDEXER_INTERVAL_SEC=5
# Database: bỏ trống = SQLite trong STORAGE_DIR. PostgreSQL/Neon: dán nguyên chuỗi Connection string (tắt pooling).
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# DATABASE_SCHEMA=           # tùy chọn: schema riêng thay cho public

# .env.local — Anvil (chain 31337). Copy thành backend/.env.local (scripts\setup.bat tự làm).
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=local
# VOICE_CAMPAIGNS / TOKEN_ADDRESS / DEPLOY_BLOCK: tự đọc từ contracts/deployments/31337.json
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80   # anvil key #0 — CÔNG KHAI, CHỈ local
USDC_VND_RATE=26000           # tỷ giá giả định cho demo
ADMIN_API_KEY=local-admin-key
DEV_AUTH_ENABLED=true         # cho phép CLI đăng nhập không cần Google (chỉ local)
QC_PRELOAD=true
# Tùy chọn — bật nút "Đăng nhập với Google" (phải trùng NEXT_PUBLIC_GOOGLE_CLIENT_ID của frontend):
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

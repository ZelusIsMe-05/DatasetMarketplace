# .env.local — Anvil (chain 31337). Copy thành backend/.env.local (scripts\setup.bat tự làm).
# Cách lấy từng giá trị: docs/environment-variables.md
NETWORK=local
# VOICE_CAMPAIGNS / TOKEN_ADDRESS / DEPLOY_BLOCK: tự đọc từ contracts/deployments/31337.json
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80   # anvil key #0 — CÔNG KHAI, CHỈ local
USDC_VND_RATE=26000           # tỷ giá giả định cho demo
DEV_AUTH_ENABLED=true         # cho phép CLI đăng nhập không cần Google (chỉ local)
QC_PRELOAD=true
# Phí xử lý (đã gồm phí mạng nền tảng trả hộ), đơn vị USDC: tạo chiến dịch, mua, rút doanh thu/quỹ mồi (mặc định 0.5 / 0.5 / 0.1)
# RELAY_FEE_CREATE_USDC=0.5
# RELAY_FEE_BUY_USDC=0.5
# RELAY_FEE_WITHDRAW_USDC=0.1
# Tùy chọn: database PostgreSQL trên Neon (nhánh dev) thay cho SQLite — docs/environment-variables.md §1b.
# Anvil khởi động lại => chạy scripts\reset-db.bat trước khi chạy backend (database được đóng dấu theo chain).
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Tùy chọn — bật nút "Đăng nhập với Google" (phải trùng NEXT_PUBLIC_GOOGLE_CLIENT_ID của frontend):
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# REVIEW_AUTO_APPROVE_HOURS=72   # chủ chiến dịch chưa duyệt bản ghi vùng xám sau số giờ này => tự duyệt (0 = chờ mãi)
# Kho audio: bỏ trống B2_BUCKET = lưu trên đĩa (STORAGE_DIR). Backblaze B2 (bucket RIÊNG TƯ): đặt đủ cả ba.
# Lấy ở Backblaze → Application Keys → Add a New Application Key (chọn đúng bucket, quyền Read and Write).
# B2_KEY_ID=                  # keyID
# B2_APPLICATION_KEY=         # applicationKey — BÍ MẬT, chỉ hiện một lần khi tạo; KHÔNG commit
# B2_BUCKET=                  # tên bucket
# (reset-local / reset-db xóa cả file trên B2 có tiền tố local-)

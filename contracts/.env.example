# KHÔNG commit file .env thật. File .env đã nằm trong .gitignore.
# Foundry tự đọc file .env trong thư mục contracts/ khi chạy `forge script`.
# Ở local KHÔNG cần file này: scripts\deploy-local.bat tự đặt biến.
# Cách lấy từng giá trị: docs/environment-variables.md
# (Chú thích đặt ở dòng riêng để trình đọc .env của Foundry không lẫn chú thích vào giá trị.)

# Ví deploy (= owner/nền tảng). Tạo bằng: cast wallet new
PRIVATE_KEY=0x...
# Địa chỉ ví relayer/QC oracle (xóa dòng = dùng ví deploy)
QC_ORACLE=0x...
# Ví nhận phí rút hộ (xóa dòng = QC_ORACLE)
FEE_COLLECTOR=0x...
# Phí rút hộ theo đơn vị token: 100000 = 0,1 USDC ≈ 2.600 ₫
CLAIM_FEE=100000

# --- Chỉ mainnet: USDC thật trên C-Chain (tra trang USDC contract addresses của Circle)
USDC_ADDRESS=0x...

# --- Chỉ SeedDemo (local/Fuji)
VOICE_CAMPAIGNS=0x...
DEMO_BUYER=0x...
# 0,05 AVAX chuyển cho ví người mua demo
DEMO_BUYER_GAS_WEI=50000000000000000
# Tùy chọn:
# SEED_TARGET_SEC=36000
# SEED_DAYS=30
# SEED_METADATA_URI=seed:demo-campaign

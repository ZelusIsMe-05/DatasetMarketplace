# contracts/.env.fuji — chép thành contracts/.env.fuji. KHÔNG commit file thật.
# CHỈ scripts\deploy-fuji.bat đọc file này. Không đặt khóa Fuji trong contracts/.env: Foundry tự đọc .env ở MỌI lần chạy
# (kể cả deploy local và test). Cách lấy từng giá trị: docs/environment-variables.md
# (Chú thích đặt ở dòng riêng để trình đọc .env không lẫn chú thích vào giá trị.)

# Ví deploy = owner, cũng là relayer + QC oracle + ví nhận phí nếu bỏ trống QC_ORACLE/FEE_COLLECTOR.
# Cùng khóa với RELAYER_PRIVATE_KEY trong backend/.env.fuji. Cần AVAX test từ faucet.
PRIVATE_KEY=0x...
# Phí rút hộ (đơn vị token): 100000 = 0,1 USDC ≈ 2.600 ₫
CLAIM_FEE=100000
# Ví người mua demo (SeedDemo nạp mUSDC thử). Bỏ trống = ví deploy.
DEMO_BUYER=
# Người mua chỉ ký (nền tảng trả phí mạng) nên mặc định không tặng AVAX
DEMO_BUYER_GAS_WEI=0
# Tùy chọn:
# QC_ORACLE=0x...
# FEE_COLLECTOR=0x...
# SEED_TARGET_SEC=36000
# SEED_DAYS=30

# Frontend Dataset Marketplace — copy thành .env.local (local) hoặc đặt trên Vercel (fuji)
# Cách lấy từng giá trị: docs/environment-variables.md
NEXT_PUBLIC_NETWORK=local                      # local | fuji | mainnet
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000      # backend FastAPI
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8386      # bỏ trống = RPC mặc định của mạng
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                  # Google Identity Services (đăng nhập người đóng góp)
